rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Персонажи: читать может любой вошедший в аккаунт участник группы.
    // Писать может как сам владелец (обычное автосохранение листа), так и
    // любой другой авторизованный участник группы — это осознанное упрощение:
    // именно так мастер выдаёт предметы (gmGiveItemFromTable) и открывает
    // рецепты кузницы (toggleRecipeKnown) через чужой документ персонажа.
    // Для закрытой группы друзей это нормально; для публичного сервиса
    // тут нужны более строгие правила (например, проверка через Cloud
    // Functions, что пишущий — действительно мастер общей с игроком сессии).
    match /characters/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Сессии: упрощённые правила, рассчитанные на закрытую группу друзей,
    // а не на публичный сервис. Любой вошедший в аккаунт может читать
    // сессию (нужно игрокам) и обновлять её (нужно и игрокам — HP/MP/лог,
    // и мастеру — противники/инициатива). Создать новую сессию может
    // только тот, кто указывает себя её мастером (gmUid).
    match /sessions/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.gmUid == request.auth.uid;
      // Обновлять может мастер сессии всегда, остальные — пока мастер их не выгнал (kicked.{uid}),
      // и никто, кроме мастера, не может менять сам список выгнанных (gmKickPlayer в gm.js).
      allow update: if request.auth != null && (
        resource.data.gmUid == request.auth.uid ||
        (!(request.auth.uid in resource.data.get('kicked', {})) &&
         request.resource.data.get('kicked', {}) == resource.data.get('kicked', {}))
      );
      // Раньше delete был запрещён вообще для всех — теперь мастер может удалить СВОЮ ЖЕ сессию
      // (нужно для автоматической чистки старых закрытых сессий, см. cleanupOldClosedSessions
      // в gm.js — иначе закрытые сессии копились бы в базе вечно).
      allow delete: if request.auth != null && resource.data.gmUid == request.auth.uid;
    }

    // Общая база предметов (лут/ингредиенты и т.д.) — читает кто угодно из
    // группы, импортирует и правит мастер через gm.html.
    match /items/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Справочник владений: данжи (описание/враги/лут/особенности), которые
    // мастер заполняет и дополняет сам на странице holds.html. Читает кто
    // угодно из группы, пишет тоже — как и везде здесь, это упрощение для
    // закрытой группы друзей.
    match /holds_dungeons/{holdId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Пресеты данжей мастера (ТЗ-2, эпик 2): личные заготовки, переживают смену устройства.
    // Читает и пишет только сам мастер — игрокам пресеты не нужны, они видят копию
    // развёрнутого данжа в сессии (sessions/{code}.currentDungeon), а её покрывает правило сессий.
    match /gmPresets/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
