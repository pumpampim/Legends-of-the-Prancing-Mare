rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Персонажи: читать может любой вошедший в аккаунт участник группы.
    // Писать может сам владелец (автосохранение листа) и мастер той сессии, в которой сейчас играет владелец:
    // игрок записывает код своей сессии в поле sessionCode (js/cloud.js, linkCharacterSession), правило сверяет
    // его с gmUid сессии. Так мастер выдаёт предметы (gmGiveItemFromTable), открывает рецепты и шлёт команды
    // (gmCmds), а посторонний пользователь чужой лист испортить не может.
    // Переходный случай: у листа, который игрок ещё не пересохранил после обновления, поля sessionCode нет —
    // такой лист пока открыт для записи всем вошедшим, как раньше. Когда у всех игроков поле появится
    // (достаточно один раз открыть сайт), эту строку надо убрать: условие !('sessionCode' in resource.data).
    function isSessionGm(code) {
      return code is string
        && exists(/databases/$(database)/documents/sessions/$(code))
        && get(/databases/$(database)/documents/sessions/$(code)).data.gmUid == request.auth.uid;
    }
    match /characters/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == uid ||
        !('sessionCode' in resource.data) ||
        isSessionGm(resource.data.sessionCode)
      );
    }

    // Сессии: упрощённые правила, рассчитанные на закрытую группу друзей,
    // а не на публичный сервис. Любой вошедший в аккаунт может читать
    // сессию (нужно игрокам) и обновлять её (нужно и игрокам — HP/MP/лог,
    // и мастеру — противники/инициатива). Создать новую сессию может
    // только тот, кто указывает себя её мастером (gmUid).
    match /sessions/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.gmUid == request.auth.uid;
      // Обновлять может мастер сессии всегда, остальные — пока мастер их не выгнал (kicked.{uid}),
      // и никто, кроме мастера, не может менять сам список выгнанных (gmKickPlayer в gm.js).
      // Мастера сессии (gmUid) не может сменить никто, иначе любой игрок сделал бы себя мастером чужих листов.
      allow update: if request.auth != null
        && request.resource.data.gmUid == resource.data.gmUid
        && (
          resource.data.gmUid == request.auth.uid ||
          (!(request.auth.uid in resource.data.get('kicked', {})) &&
           request.resource.data.get('kicked', {}) == resource.data.get('kicked', {}))
        );
      // Раньше delete был запрещён вообще для всех — теперь мастер может удалить СВОЮ ЖЕ сессию
      // (нужно для автоматической чистки старых закрытых сессий, см. cleanupOldClosedSessions
      // в gm.js — иначе закрытые сессии копились бы в базе вечно).
      allow delete: if request.auth != null && resource.data.gmUid == request.auth.uid;
    }

    // Общая база предметов (лут/ингредиенты и т.д.) — читает кто угодно из
    // группы, импортирует и правит мастер через gm.html.
    match /items/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Справочник владений (holds.html) живёт в браузере, в облако ничего не пишет, поэтому коллекции holds_dungeons
    // больше нет: правило убрано, всё не перечисленное Firestore запрещает.

    // Пресеты данжей мастера (ТЗ-2, эпик 2): личные заготовки, переживают смену устройства.
    // Читает и пишет только сам мастер — игрокам пресеты не нужны, они видят копию
    // развёрнутого данжа в сессии (sessions/{code}.currentDungeon), а её покрывает правило сессий.
    match /gmPresets/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Журнал ошибок сайта (js/00-error-log.js пишет, gm.html «Ошибки у игроков» читает и чистит).
    // Создать запись можно только от своего имени и небольшого размера; менять нельзя.
    match /errors/{id} {
      allow read, delete: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().size() < 20
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 400;
    }
  }
}
